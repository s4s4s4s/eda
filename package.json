{
  "name": "eda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check-menu": "esbuild scripts/check-menu.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/check-menu.mjs && node node_modules/.cache/eda/check-menu.mjs",
    "products": "node scripts/build-products.mjs",
    "food-search": "node scripts/food-search.mjs",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "npm run test:data && npm run test:menu && npm run test:cycle && npm run test:nutrition && npm run test:rules && npm run test:log && npm run test:storage && npm run test:export && npm run test:norms && npm run test:week && npm run test:preferences && npm run test:verdict && npm run test:food-resolve && npm run test:food",
    "test:menu": "esbuild test/menu.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/menu.mjs && node node_modules/.cache/eda/menu.mjs",
    "test:cycle": "esbuild test/cycle.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/cycle.mjs && node node_modules/.cache/eda/cycle.mjs",
    "test:nutrition": "esbuild test/nutrition.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/nutrition.mjs && node node_modules/.cache/eda/nutrition.mjs",
    "test:rules": "esbuild test/rules.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/rules.mjs && node node_modules/.cache/eda/rules.mjs",
    "test:log": "esbuild test/log.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/log.mjs && node node_modules/.cache/eda/log.mjs",
    "test:export": "esbuild test/export.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/export.mjs && node node_modules/.cache/eda/export.mjs",
    "test:data": "esbuild test/data.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/data.mjs && node node_modules/.cache/eda/data.mjs",
    "test:storage": "esbuild test/storage.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/storage.mjs && node node_modules/.cache/eda/storage.mjs",
    "test:norms": "esbuild test/norms.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/norms.mjs && node node_modules/.cache/eda/norms.mjs",
    "test:week": "esbuild test/week.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/week.mjs && node node_modules/.cache/eda/week.mjs",
    "test:preferences": "esbuild test/preferences.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/preferences.mjs && node node_modules/.cache/eda/preferences.mjs",
    "test:verdict": "esbuild test/verdict.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/verdict.mjs && node node_modules/.cache/eda/verdict.mjs",
    "test:food-resolve": "esbuild test/food-resolve.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/food-resolve.mjs && node node_modules/.cache/eda/food-resolve.mjs",
    "test:food": "esbuild test/food.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/eda/food.mjs && node node_modules/.cache/eda/food.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1"
  }
}
